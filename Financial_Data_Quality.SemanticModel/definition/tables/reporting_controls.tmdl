table reporting_controls
	lineageTag: 2a4575e8-eaf9-455e-aeb9-64d22c7c1925

	measure Filings = DISTINCTCOUNT('reporting_controls'[adsh])
		formatString: 0
		displayFolder: Reporting Controls
		lineageTag: f9c5a892-c2ad-4a2a-bb57-337292c52917

	measure Companies = DISTINCTCOUNT('reporting_controls'[cik])
		formatString: 0
		displayFolder: Reporting Controls
		lineageTag: f7084476-465f-4640-a932-51691576ddd4

	measure 'Numeric Facts' = SUMX(VALUES('reporting_controls'[adsh]), CALCULATE(MAX('reporting_controls'[numeric_facts])))
		formatString: #,0
		displayFolder: Reporting Controls
		lineageTag: 57858239-2ef0-407d-8eaa-10e7e0dfc84d

	measure 'Rule Evaluations' = SUM('reporting_controls'[checked_count])
		formatString: #,0
		displayFolder: Reporting Controls
		lineageTag: 56a7f83b-b067-4faa-b3ed-c6502c7dcad3

	measure 'Actionable Events' = COALESCE(CALCULATE(SUM('reporting_controls'[flagged_count]), KEEPFILTERS('reporting_controls'[severity] <> "INFO")), 0)
		formatString: #,0
		displayFolder: Reporting Controls
		lineageTag: 1818e2ec-ad62-42b9-91be-b454d8389e4b

	measure 'Nil Disclosures' = COALESCE(CALCULATE(SUM('reporting_controls'[flagged_count]), KEEPFILTERS('reporting_controls'[rule_id] = "NIL_DISCLOSURE")), 0)
		formatString: #,0
		displayFolder: Reporting Controls
		lineageTag: 5b3e1972-2ea4-4af7-94bf-3d3791d99033

	measure 'Flagged Events' = SUM('reporting_controls'[flagged_count])
		formatString: #,0
		displayFolder: Reporting Controls
		lineageTag: 0921af90-cdea-43b6-ae2f-31fd040e79b1

	measure 'Passed Evaluations' = SUM('reporting_controls'[passed_count])
		formatString: #,0
		displayFolder: Reporting Controls
		lineageTag: a2684cc2-a15f-4818-a921-f4215cc5bc9e

	measure 'Balance Checks Passed' = SUMX(VALUES('reporting_controls'[adsh]), CALCULATE(MAX('reporting_controls'[balance_passed])))
		formatString: 0
		displayFolder: Reporting Controls
		lineageTag: fd841d4b-aed6-413a-b15b-1746faf3be19

	measure 'Balance Pass Rate' = DIVIDE([Balance Checks Passed], [Filings])
		formatString: 0%
		displayFolder: Reporting Controls
		lineageTag: 3eb01151-d016-478c-9ddc-a453858727d0

	measure 'Reported Assets (USD bn)' = DIVIDE(SUMX(VALUES('reporting_controls'[adsh]), CALCULATE(MAX('reporting_controls'[assets_usd]))), 1000000000)
		formatString: #,0.0
		displayFolder: Reporting Controls
		lineageTag: 18781db6-d219-4ac0-986c-8f64aa957790

	measure 'Quarter Net Income (USD bn)' = DIVIDE(SUMX(VALUES('reporting_controls'[adsh]), CALCULATE(MAX('reporting_controls'[quarter_net_income_usd]))), 1000000000)
		formatString: #,0.00
		displayFolder: Reporting Controls
		lineageTag: da27f5fd-fc06-404c-8e6f-92c16688e7b5

